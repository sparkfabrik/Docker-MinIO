{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Silo uses MinIO-style RELEASE.<date>T<time>Z tags; the regex compares date, hour and minute, and skips variants such as -distroless.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "pgsty/silo",
        "docker.io/pgsty/silo"
      ],
      "versioning": "regex:^RELEASE\\.(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})T(?<build>\\d{2})-(?<revision>\\d{2})-\\d{2}Z$"
    }
  ]
}
